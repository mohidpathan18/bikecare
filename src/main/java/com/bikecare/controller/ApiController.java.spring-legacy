package com.bikecare.controller;
import java.math.*;import java.time.*;import java.util.*;import org.springframework.http.*;import org.springframework.jdbc.core.JdbcTemplate;import org.springframework.security.crypto.password.PasswordEncoder;import org.springframework.security.core.context.*;import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;import org.springframework.security.web.context.HttpSessionSecurityContextRepository;import org.springframework.security.web.csrf.CsrfToken;import org.springframework.web.bind.annotation.*;import jakarta.servlet.http.*;
@RestController @RequestMapping("/api") public class ApiController {
 private final JdbcTemplate db;private final PasswordEncoder encoder;ApiController(JdbcTemplate d,PasswordEncoder e){db=d;encoder=e;}
 record User(long id,String name,String email,String role){} User current(HttpServletRequest r){Object o=r.getSession(false)==null?null:r.getSession(false).getAttribute("user");return (User)o;} ResponseEntity<?> unauth(){return ResponseEntity.status(401).body(Map.of("error","Please sign in to continue."));} boolean admin(User u){return u!=null&&u.role().equals("ADMIN");}
 @GetMapping("/health") Map<String,String> health(){return Map.of("status","ok");}@GetMapping("/csrf") Map<String,String> csrf(CsrfToken t){return Map.of("token",t.getToken());}@GetMapping("/auth/me") Object me(HttpServletRequest r){User u=current(r);return u==null?ResponseEntity.status(401).body(Map.of("error","Not signed in")):Map.of("id",u.id(),"name",u.name(),"email",u.email(),"role",u.role());}
 @PostMapping("/auth/signup") ResponseEntity<?> signup(@RequestBody Map<String,String> x){String name=trim(x.get("name")),email=trim(x.get("email")).toLowerCase(),pw=x.getOrDefault("password","");if(name.length()<2||name.length()>100||!email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")||pw.length()<10)return ResponseEntity.badRequest().body(Map.of("error","Enter a valid name and email; password must be at least 10 characters."));if(db.queryForObject("SELECT COUNT(*) FROM users WHERE email=?",Integer.class,email)>0)return ResponseEntity.status(409).body(Map.of("error","An account with that email already exists."));db.update("INSERT INTO users(name,email,password_hash) VALUES(?,?,?)",name,email,encoder.encode(pw));return ResponseEntity.status(201).body(Map.of("message","Account created. Please sign in."));}
 @PostMapping("/auth/login") ResponseEntity<?> login(@RequestBody Map<String,String>x,HttpServletRequest req){String email=trim(x.get("email")).toLowerCase();var rows=db.query("SELECT id,name,email,password_hash,role FROM users WHERE email=?",(rs,n)->new Object[]{rs.getLong(1),rs.getString(2),rs.getString(3),rs.getString(4),rs.getString(5)},email);if(rows.isEmpty()||!encoder.matches(x.getOrDefault("password",""),(String)rows.get(0)[3]))return ResponseEntity.status(401).body(Map.of("error","Email or password is incorrect."));Object[] a=rows.get(0);User u=new User((long)a[0],(String)a[1],(String)a[2],(String)a[4]);HttpSession s=req.getSession(true);req.changeSessionId();s.setAttribute("user",u);return ResponseEntity.ok(Map.of("user",Map.of("id",u.id(),"name",u.name(),"email",u.email(),"role",u.role()),"redirect",u.role().equals("ADMIN")?"/admin.html":"/dashboard.html"));}
 @PostMapping("/auth/logout") Map<String,String> logout(HttpServletRequest r){if(r.getSession(false)!=null)r.getSession(false).invalidate();return Map.of("message","Signed out.");}
 @PostMapping("/bookings") ResponseEntity<?> createBooking(@RequestBody Map<String,String>x,HttpServletRequest r){User u=current(r);if(u==null)return (ResponseEntity)unauth();String name=trim(x.get("customerName")),bike=trim(x.get("bike")),service=trim(x.get("serviceType")),date=trim(x.get("preferredDate")),contact=trim(x.get("contact"));try{if(name.length()<2||bike.isBlank()||service.isBlank()||contact.isBlank()||LocalDate.parse(date).isBefore(LocalDate.now()))throw new IllegalArgumentException();}catch(Exception e){return ResponseEntity.badRequest().body(Map.of("error","Check all required fields and choose today or a future date."));}db.update("INSERT INTO bookings(user_id,customer_name,bike,service_type,preferred_date,contact,description) VALUES(?,?,?,?,?,?,?)",u.id(),name,bike,service,date,contact,trim(x.get("description")));Long id=db.queryForObject("SELECT last_insert_rowid()",Long.class);return ResponseEntity.status(201).body(Map.of("message","Booking saved successfully.","id",id));}
 String bookingSql="SELECT b.id,b.customer_name,b.bike,b.service_type,b.preferred_date,b.contact,b.description,b.status,b.created_at,u.email FROM bookings b JOIN users u ON u.id=b.user_id";
 @GetMapping("/bookings") Object bookings(HttpServletRequest r,@RequestParam(required=false)String q,@RequestParam(required=false)String status){User u=current(r);if(u==null)return unauth();String sql=bookingSql+(admin(u)?" WHERE 1=1":" WHERE b.user_id=?");List<Object> args=new ArrayList<>();if(!admin(u))args.add(u.id());if(q!=null&&!q.isBlank()){sql+=" AND (lower(b.customer_name) LIKE ? OR lower(b.bike) LIKE ? OR lower(u.email) LIKE ?)";String like="%"+q.toLowerCase()+"%";args.add(like);args.add(like);args.add(like);}if(status!=null&&!status.isBlank()){sql+=" AND b.status=?";args.add(status);}sql+=" ORDER BY b.created_at DESC";return db.queryForList(sql,args.toArray());}
 @PatchMapping("/admin/bookings/{id}/status") ResponseEntity<?> status(@PathVariable long id,@RequestBody Map<String,String>x,HttpServletRequest r){User u=current(r);if(u==null)return unauth();if(!admin(u))return ResponseEntity.status(403).body(Map.of("error","Administrator access required."));String st=x.getOrDefault("status","");if(!Set.of("Pending","Approved","In Progress","Completed","Cancelled").contains(st))return ResponseEntity.badRequest().body(Map.of("error","Invalid status."));int n=db.update("UPDATE bookings SET status=? WHERE id=?",st,id);return n==0?ResponseEntity.notFound().build():ResponseEntity.ok(Map.of("message","Status updated."));}
 @GetMapping("/admin/stats") Object stats(HttpServletRequest r){User u=current(r);if(u==null)return unauth();if(!admin(u))return ResponseEntity.status(403).body(Map.of("error","Administrator access required."));return Map.of("total",count(""),"pending",count("Pending"),"approved",count("Approved"),"completed",count("Completed"));}int count(String s){return s.isEmpty()?db.queryForObject("SELECT COUNT(*) FROM bookings",Integer.class):db.queryForObject("SELECT COUNT(*) FROM bookings WHERE status=?",Integer.class,s);}
 @PostMapping("/bills") ResponseEntity<?> bill(@RequestBody Map<String,Object>x,HttpServletRequest r){User u=current(r);if(u==null)return (ResponseEntity)unauth();if(!admin(u))return ResponseEntity.status(403).body(Map.of("error","Administrator access required."));try{long bid=Long.parseLong(x.get("bookingId").toString());BigDecimal service=new BigDecimal(x.get("serviceCharge").toString()),parts=new BigDecimal(x.get("partsCharge").toString()),rate=new BigDecimal(x.get("taxRate").toString());if(service.signum()<0||parts.signum()<0||rate.signum()<0||rate.compareTo(new BigDecimal("100"))>0)throw new IllegalArgumentException();Integer n=db.queryForObject("SELECT COUNT(*) FROM bookings WHERE id=?",Integer.class,bid);if(n==0)return ResponseEntity.badRequest().body(Map.of("error","Booking not found."));BigDecimal subtotal=service.add(parts),tax=subtotal.multiply(rate).divide(new BigDecimal("100"),2,RoundingMode.HALF_UP),total=subtotal.add(tax);String invoice="BC-"+UUID.randomUUID().toString().substring(0,8).toUpperCase();db.update("INSERT INTO bills(invoice_no,booking_id,service_charge,parts_charge,tax_rate,tax_amount,total) VALUES(?,?,?,?,?,?,?)",invoice,bid,service,parts,rate,tax,total);Long id=db.queryForObject("SELECT last_insert_rowid()",Long.class);return ResponseEntity.status(201).body(Map.of("id",id,"invoiceNo",invoice,"serviceCharge",service,"partsCharge",parts,"taxRate",rate,"taxAmount",tax,"total",total));}catch(Exception e){return ResponseEntity.badRequest().body(Map.of("error","Enter valid charges, tax rate and booking."));}}
 @GetMapping("/bills") Object bills(HttpServletRequest r){User u=current(r);if(u==null)return unauth();String sql="SELECT bi.*,b.customer_name,b.bike,b.service_type,b.user_id,u.name AS account_name,u.email FROM bills bi JOIN bookings b ON b.id=bi.booking_id JOIN users u ON u.id=b.user_id";return admin(u)?db.queryForList(sql+" ORDER BY bi.created_at DESC"):db.queryForList(sql+" WHERE b.user_id=? ORDER BY bi.created_at DESC",u.id());}
 private String trim(String s){return s==null?"":s.trim();}
}


